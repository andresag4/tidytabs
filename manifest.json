{
  "manifest_version": 3,
  "name": "tidytabs",
  "version": "0.1.0",
  "description": "Group your tabs by domain in one click.",
  "permissions": ["tabs", "tabGroups", "storage"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tidy tabs"
  },
  "options_page": "options.html"
}
