{
  "manifest_version": 3,
  "name": "tidytabs",
  "version": "0.1.0",
  "description": "Group your tabs by domain in one click.",
  "permissions": ["tabs", "tabGroups", "storage", "clipboardWrite", "offscreen", "scripting", "activeTab"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tidy tabs",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "options.html"
}
